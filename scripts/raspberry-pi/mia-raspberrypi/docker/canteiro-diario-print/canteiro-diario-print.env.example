# canteiro-diario-print — live copy: mia-raspberrypi:~/canteiro-diario-print/env/canteiro-diario-print.env
# (chmod 600, NOT in git). Values come from the repo-root .env (authoritative).
#
# Failure alerts (regra Eduardo 04/09/2026: every rc≠0 posts its reason to Casa SmokeTests).
# WAHA lives on the bnu LAN (LXC 101) — from MIA it is reached over the tailnet through the socat
# relay on bnu-proxmox:3001 → 10.1.1.126:3000, the same transport the ara timelapse alerts use
# (REMOTE_ACCESS.md §5). Until 10/09/2026 these were empty and MIA failed silently
# ("alerta nao configurado" in `docker logs`).
WAHA_URL=http://bnu-proxmox:3001
WAHA_KEY=__BNU_WAHA_API_KEY__
WAHA_SESSION=default
ALERT_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__
RCLONE_REMOTE=ceuazul:
DIARIO_DIR=Diario
# Direct IPP queue (lpadmin -p HP_OfficeJet_IPP -E -v ipp://192.168.2.74/ipp/print -m everywhere) — same
# reason as bnu: the cups-browsed implicit class can lose its destination host at print time.
PRINTER=HP_OfficeJet_IPP
PRINT_OPTIONS=-o fit-to-page
