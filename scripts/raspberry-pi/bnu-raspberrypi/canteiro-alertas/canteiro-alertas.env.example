# canteiro-alertas — live copy: bnu-raspberrypi:~/canteiro-jobs/env/canteiro-alertas.env (chmod 600, NOT in git)
# Values come from the repo-root .env (authoritative; see REMOTE_ACCESS.md §5 drift list).

# log = decide + alertas.jsonl, sends nothing · shadow = SmokeTests with "SOMBRA" · live = obra group
# Each step up (log → shadow → live) only with Eduardo's explicit OK.
MODE=log

# WhatsApp (WAHA on LXC 101, bnu LAN) — same values as the other canteiro jobs
WAHA_URL=http://10.1.1.126:3000
WAHA_KEY=__BNU_WAHA_API_KEY__
WAHA_SESSION=default
# Trucks (and pours, when on) → the obra group "Cenci Céu Azul Casa-Hangar" (decisão Eduardo
# 13/10/2026; until then "Casa Céu Azul")
GROUP_JID=__ARA_FIN_GROUP_JID__
# "Veículo não visto antes" → "Casa Céu Azul" (= ARA_WHATSAPP_GROUP_JID): the vehicle registry is
# internal, never the obra group. Empty = that alert is logged as failed, never re-routed.
INTERNO_JID=__ARA_ALERTAS_GROUP_JID__
TEST_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__

# OpenAI Decisions API — the key bnu Home Assistant already uses (IP-allowlisted to bnu;
# decisão Eduardo 08/10/2026: no new key)
OPENAI_API_KEY=__BNU_HA_FRIGATE_OPENAI_API_KEY__
BUDGET_USD_DAY=0.30

# Frigate (bnu LXC 105, tailnet) — same as canteiro-diario
FRIGATE_URL=http://bnu-frigate:5000
FRIGATE_CAMERA=canteiro
LABELS=car,bus,motorcycle

# Backtest settings (home-ara decision 0010, adendo 09/10/2026)
QUESTIONS=v2                 # v2 = backtest de 09/10 (ao vivo). v3 = +poliguindaste com caçamba: EXPERIMENTAL, regrediu em 29/10/2026 (munck → carroceria) — só depois de passar o gate do backtest
THR=0.85
MIN_DUR_S=10
POUR_ALERTS=0
POLL_S=15

# Vehicle registry (home-ara decision 0011): learn every parked car/van (descriptors +
# high-res recording crop) into /var/lib/canteiro-alertas/veiculos/ — no messages.
APRENDER_VEICULOS=1
# "Veículo não visto antes" alert — OFF during the 2-week learning window (~23/10/2026),
# then only with Eduardo's OK.
DESCONHECIDOS=0

# Galeria dos caminhões do dia (decisão 0010, adendo 29/10/2026): antes de alertar um
# caminhão novo, pergunta se é o mesmo de algum já alertado hoje; só suprime com P ≥ este valor.
P_MESMO_CAMINHAO=0.8
# Snapshots dos caminhões alertados (STATE_DIR/caminhoes) guardados por N dias
CAM_DIAS=7
