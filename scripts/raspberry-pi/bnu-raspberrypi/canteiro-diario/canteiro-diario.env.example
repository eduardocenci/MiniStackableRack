# canteiro-diario — live copy: bnu-raspberrypi:~/canteiro-jobs/env/canteiro-diario.env (chmod 600, NOT in git)
# Values come from the repo-root .env (authoritative; see REMOTE_ACCESS.md §5 drift list).

# WhatsApp (WAHA on LXC 101, bnu LAN) — same values as canteiro-presenca.env
WAHA_URL=http://10.1.1.126:3000
WAHA_KEY=__BNU_WAHA_API_KEY__
WAHA_SESSION=default
# Production target = grupo Cenci Céu Azul Casa-Hangar (ARA_WHATSAPP_GROUP_JID). First week
# (staging, decisão Eduardo 09/09/2026): point GROUP_JID at the SmokeTests group, then flip.
GROUP_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__
TEST_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__
ALERT_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__

# Evidence sources
FRIGATE_URL=http://bnu-frigate:5000
FRIGATE_CAMERA=canteiro
ARA_NTO_URL=http://ara-raspberrypi:5000
LISTENER_URL=http://10.1.1.126:8788
LISTENER_TOKEN=__BNU_WAHA_LISTENER_TOKEN__
OBRA_CHAT_JID=__ARA_WHATSAPP_GROUP_JID__
SHEET_ID=__ARA_FIN_SHEET_ID__
SHEET_TAB=PlanejadoRealizado
# GSA_KEYFILE is set by compose (/config/gsa.json ← ~/canteiro-jobs/env/gsa.json)
# condfy gate tags: ssh root@bnu-proxmox → pct exec 101 → docker exec condfy-bridge (optional)
PROXMOX_HOST=bnu-proxmox
PROXMOX_USER=root
PROXMOX_PW=__PROXMOX_PW__
CONDFY_LXC=101

# Drive (rclone remote from ~/.config/rclone/rclone.conf) and printer (host CUPS queue)
RCLONE_REMOTE=ceuazul:
DIARIO_DIR=Diario
TIMELAPSE_DIR=Timelapse
PRINTER=HP_Smart_Tank_580_590_series_ACD97F
PRINT_OPTIONS=-o media=A4

# Optional fallback for diario.json when the routine could not write to Drive:
# GITHUB_RAW_JSON=https://raw.githubusercontent.com/eduardocenci/home-ara/main/docs/diario/{date}.json
# GITHUB_TOKEN=__github_fine_grained_token_read_only__
