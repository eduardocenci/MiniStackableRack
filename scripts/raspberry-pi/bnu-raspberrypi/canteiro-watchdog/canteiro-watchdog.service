[Unit]
Description=Canteiro watchdog - WhatsApp alert when the ARA site drops/returns
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eduardocenci
StateDirectory=canteiro-watchdog
EnvironmentFile=/etc/canteiro-watchdog.env
ExecStart=/usr/bin/python3 /usr/local/bin/canteiro-watchdog.py
