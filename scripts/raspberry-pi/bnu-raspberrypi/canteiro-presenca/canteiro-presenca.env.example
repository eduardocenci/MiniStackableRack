# /etc/canteiro-presenca.env — live copy on bnu-raspberrypi (values NOT committed).
# WAHA credentials are the same ones canteiro-watchdog uses (root .env: BNU_WAHA_*).
WAHA_URL=http://10.1.1.126:3000
WAHA_KEY=<BNU_WAHA_API_KEY>
WAHA_SESSION=default
# Family/canteiro group that already receives the watchdog alerts
GROUP_JID=<group jid>@g.us
# Casa SmokeTests group — --test sends here by default
TEST_JID=<smoketests jid>@g.us
ARA_NTO_URL=http://ara-raspberrypi:5000
# Fixed devices at the obra LAN (not people): Starlink router, Intelbras iM9+ camera
EXCLUDE_MACS=74:24:9f:c5:b2:5f,54:ba:d9:bd:34:e3
# The ara Pi itself shows up by hostname (its MAC is null in netoverview)
EXCLUDE_HOSTNAMES=ara-raspberrypi
# Only devices inside the obra LAN count as people (drops e.g. Docker-bridge
# 172.17.0.x ghosts should the scanner ever report them again)
LAN_CIDR=192.168.1.0/24

