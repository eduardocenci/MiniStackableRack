# Live copy: /etc/systemd/system/canteiro-sunset-compare.timer
# Seg–sex 20:10 America/Sao_Paulo (o relogio deste Pi e Europe/London — o
# fuso vem daqui e o script recalcula o dia com ZoneInfo), 10 min depois do
# upload das 20:00 do ara Pi. Dias de trabalho apenas (decisao Eduardo
# 27/08/2026); o script ainda pula sab/dom caso o Persistent recupere um
# disparo perdido em fim de semana.
[Unit]
Description=Mon-Fri 20:10 (America/Sao_Paulo) canteiro sunset comparison

[Timer]
OnCalendar=Mon..Fri 20:10:00 America/Sao_Paulo
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
