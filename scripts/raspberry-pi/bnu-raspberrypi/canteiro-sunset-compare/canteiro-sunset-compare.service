[Service]
Type=oneshot
User=eduardocenci
EnvironmentFile=/etc/canteiro-sunset-compare.env
ExecStart=/usr/bin/python3 /usr/local/bin/canteiro-sunset-compare.py
TimeoutStartSec=45min
