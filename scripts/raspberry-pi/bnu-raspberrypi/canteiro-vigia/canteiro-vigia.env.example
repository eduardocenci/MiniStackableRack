# canteiro-vigia — live copy: bnu-raspberrypi:~/canteiro-vigia/env/canteiro-vigia.env (chmod 600, NOT in git)
# Values come from the repo-root .env (authoritative; see REMOTE_ACCESS.md §5 drift list).

# log = decide + vigia.jsonl, sends nothing · shadow = Casa SmokeTests with "SOMBRA" · live = Casa Céu Azul
# Each step up (log → shadow → live) only with Eduardo's explicit OK (live since 22/10/2026).
MODE=live
# "🔒 Vigia ligado / 🔓 Vigia desligado" notes: teste (Casa SmokeTests) · grupo (Casa Céu Azul) · nao
AVISAR_ESTADO=teste

# WhatsApp (WAHA on LXC 101, bnu LAN) — same values as the other canteiro jobs
WAHA_URL=http://10.1.1.126:3000
WAHA_KEY=__BNU_WAHA_API_KEY__
WAHA_SESSION=default
# "Casa Céu Azul" — the family/obra-cameras group (same JID as ARA_WHATSAPP_GROUP_JID)
GROUP_JID=__ARA_ALERTAS_GROUP_JID__
TEST_JID=__SMOKETESTS_WHATSAPP_GROUP_JID__
# Optional last line of the caption (ARA_LIVE_VIEW_URL); empty = no link
LIVE_URL=

# Frigate (bnu LXC 105) — same as canteiro-alertas / canteiro-diario
FRIGATE_URL=http://bnu-frigate:5000
FRIGATE_CAMERA=canteiro
LABELS=person,car,bus,motorcycle,bicycle

# Canteiro Wi-Fi: Starlink router gRPC through the ara Pi's router-proxy socat relay
# (scripts/raspberry-pi/ara-raspberrypi/docker/router-proxy/), netoverview as ±5 min fallback
ROUTER_GRPC=ara-raspberrypi2:9000
ARA_NTO_URL=http://ara-raspberrypi2:5000
LAN_CIDR=192.168.1.0/24
# Fixed gear, never "someone": Starlink router 74:24:9f, iM9 camera 54:ba:d9, the Pi 88:a2:9e
# (the router masks client MACs down to the OUI, hence OUIs + names, not full MACs)
FIXED_OUIS=74:24:9f,54:ba:d9,88:a2:9e
FIXED_NAMES=controller,im9-m,ara-raspberrypi

# Rules (decisão Eduardo 22/10/2026)
# Armed = the Wi-Fi has had no person's device for ARMAR_APOS_MIN (a phone that only blinked off does not arm);
# disarmed the moment one appears. Fri evening → Mon morning in practice; holidays and empty weeknights too.
ARMAR_APOS_MIN=5
REDE_POLL_S=30
# Testing only: armed even with people on the Wi-Fi
FORCAR_ARMADO=0
# "the following minute": a device that associated between t0-PRE_S and t0+JANELA_S is the friendly sign
JANELA_S=60
PRE_S=120
# one message per episode — later detections within EPISODIO_MIN of the open episode do not repeat
# (exception: vehicle first + person after = a second message with the person's photo)
EPISODIO_MIN=15
# runaway caps — beyond them only vigia.jsonl, one "⏸️" note to TEST_JID per day
MAX_HORA=6
MAX_DIA=24
POLL_S=10
