[Unit]
Description=ARA canteiro live camera on the attached screen (mpv)
After=graphical.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=eduardocenci
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
# Reads from the LOCAL go2rtc (not the ara relay directly): go2rtc pulls the
# canteiro from ara ONCE and fans it out on bnu to this screen AND the TV
# cast — so ara's Starlink upload carries a single copy, never two. (Reading
# ara directly here plus go2rtc for the TV was 2× the upload; Starlink
# couldn't sustain it and the second reader stalled — 2026-08-26.)
ExecStart=/usr/bin/mpv --fullscreen --force-window=yes --no-osc \
  --no-input-default-bindings --no-audio --rtsp-transport=tcp \
  --profile=low-latency --hwdec=auto-copy --keep-open=no \
  --stop-screensaver=yes --network-timeout=10 \
  rtsp://127.0.0.1:8554/canteiro
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
