# Live copy: /etc/systemd/system/timelapse-trabalho.timer
# A cada 15 min das 07:00 às 18:00 inclusive (45 disparos/dia).
# Cadência era 25 min até 26/08/2026 (decisão Eduardo: 15 min).
[Unit]
Description=Timelapse ARA — dispara frame de presença a cada 15 min (07:00–18:00)

[Timer]
OnCalendar=*-*-* 07..17:00,15,30,45:00
OnCalendar=*-*-* 18:00:00
AccuracySec=15s

[Install]
WantedBy=timers.target
