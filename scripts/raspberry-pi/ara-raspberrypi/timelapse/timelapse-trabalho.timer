# Live copy: /etc/systemd/system/timelapse-trabalho.timer
# Cadência exata de 25 min das 07:00 às 17:50 (27 disparos/dia). O padrão de
# minutos se repete a cada 5 h (12 × 25 min), daí as cinco linhas.
[Unit]
Description=Timelapse ARA — dispara frame de presença a cada 25 min (07:00–17:50)

[Timer]
OnCalendar=*-*-* 07,12,17:00,25,50:00
OnCalendar=*-*-* 08,13:15,40:00
OnCalendar=*-*-* 09,14:05,30,55:00
OnCalendar=*-*-* 10,15:20,45:00
OnCalendar=*-*-* 11,16:10,35:00
AccuracySec=15s

[Install]
WantedBy=timers.target
