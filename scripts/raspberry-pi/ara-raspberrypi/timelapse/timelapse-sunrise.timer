# Live copy: /etc/systemd/system/timelapse-sunrise.timer
# 05:00 cobre o nascer do sol mais cedo do ano (~05:15, dezembro); o script
# calcula o nascer do dia e dorme até cada janela (T, T+10, T+20).
[Unit]
Description=Timelapse ARA — inicia a sequência do nascer do sol às 05:00

[Timer]
OnCalendar=*-*-* 05:00:00
AccuracySec=15s

[Install]
WantedBy=timers.target
