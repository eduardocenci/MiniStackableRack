# Live copy: /etc/systemd/system/timelapse-sunset.timer
# 16:40 cobre o T−20 mais cedo do ano (17:09, junho); o script calcula o pôr
# do sol do dia e dorme até cada janela.
[Unit]
Description=Timelapse ARA — inicia a sequência do pôr do sol às 16:40

[Timer]
OnCalendar=*-*-* 16:40:00
AccuracySec=15s

[Install]
WantedBy=timers.target
