# Live copy: /etc/systemd/system/timelapse-sunset.service
# Fica dormindo entre as janelas solares (T−20 … T+20); no pior caso do ano
# roda das 16:40 às ~19:35 — por isso o timeout infinito.
[Unit]
Description=Timelapse ARA — 5 janelas solares do pôr do sol (PT + lente fixa)
After=mediamtx.service
Wants=mediamtx.service

[Service]
Type=oneshot
User=eduardocenci
ExecStart=/usr/local/bin/timelapse-capture sunset
TimeoutStartSec=infinity
