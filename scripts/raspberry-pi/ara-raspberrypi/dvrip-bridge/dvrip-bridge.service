[Unit]
Description=Bridge camera Intelbras-1/DVRIP port 37777 onto the tailnet
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
ExecStart=/usr/bin/socat TCP-LISTEN:37777,fork,reuseaddr TCP:192.168.1.56:37777
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
