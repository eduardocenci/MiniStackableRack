# canteiro-mosaico — live mosaic [fixed lens | PT lens] of the ARA canteiro.
# Authoritative copy: scripts/proxmox/frigate/bnu-frigate/canteiro-mosaico.service
# Live copy:          bnu Frigate LXC 105:/etc/systemd/system/canteiro-mosaico.service
# What/why: see canteiro-mosaico.sh.
[Unit]
Description=canteiro-mosaico (fixed lens | PT lens -> H.264 2560x720 -> canteiro-hls on bnu-raspberrypi)
After=network-online.target go2rtc.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/canteiro-mosaico.sh
Restart=always
RestartSec=5
# A stop that hangs must not keep the stream down: on 2026-11-15 a restart waited the default
# 90 s for SIGTERM before systemd killed ffmpeg.
TimeoutStopSec=10
# The pump (python) and its three ffmpeg children (one feeder per lens + the encoder) share this
# cgroup; a stop or a restart takes all of them (KillMode=control-group, the default).
# Single-process composer: ~1.1 GB steady (2026-11-16); with its outputs dead it grew 25 MB/s
# (2026-11-15) and the LXC-wide OOM killer may pick a Frigate process instead: keep the damage
# in this unit. 2000M since 2026-11-16 (the LXC went to 6 GB). The pump bounds its own queues
# (<= 90 frames per lens, 125 MB) and writes to the encoder with a 3 s timeout, so nothing
# here grows any more - the cap stays as the last line.
MemoryMax=2000M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
