[Unit]
Description=WAHA proxy (bg-HA → bnu WAHA over Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3001,bind=192.168.0.120,fork,reuseaddr TCP:100.113.204.100:3001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
