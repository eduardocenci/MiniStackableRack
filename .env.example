# ! File in use lies in root directory named ".env", this is an example file only !
# =============================================================================
# COMMON (shared across all regions)
# =============================================================================

# Raspberry Pi
RASPBERRYPI_LOGIN=your_login
RASPBERRYPI_PW=your_password

# GL KVM
GLKVM_LOGIN=your_login
GLKVM_PW=your_password

# Proxmox
PROXMOX_LOGIN=your_login
PROXMOX_PW=your_password

# Proxmox API for globalnet /api/node-stats (load bars).
# Scoped read-only tokens, preferred over PVE_USER/PVE_PASSWORD below
# (pveum user token add root@pam globalnet --privsep 1
#  + pveum acl modify / --tokens 'root@pam!globalnet' --roles PVEAuditor):
PVE_TOKEN_BNU=root@pam!globalnet=your_token_uuid
PVE_TOKEN_PLY=root@pam!globalnet=your_token_uuid
PVE_TOKEN_BG=root@pam!globalnet=your_token_uuid
PVE_TOKEN_FLN=root@pam!globalnet=your_token_uuid
# Fallback: ticket auth with the root credentials
PVE_USER=root@pam
PVE_PASSWORD=your_password

# PLY UniFi controller for globalnet /api/wan-usage (live WAN throughput).
# Must be a LOCAL-ONLY UniFi admin (view-only role suffices) — Ubiquiti SSO
# accounts require MFA and cannot log in via the API. Reached through the
# unifi-proxy.service socat relay on ply-proxmox (:8443 -> 192.168.0.1:443).
PLY_UNIFI_URL=https://ply-proxmox:8443
PLY_UNIFI_USER=your_login
PLY_UNIFI_PASSWORD=your_password

# Home Assistant — Advanced SSH & Web Terminal
HA_SSH_LOGIN=your_login
HA_SSH_PW=your_password

# =============================================================================
# BG
# =============================================================================

# Raspberry Pi
BG_RASPBERRYPI_HOST_KEY=your_host_key

# Home Assistant
BG_HA_URL=http://bg-homeassistant:8123
BG_HA_TOKEN=your_long_lived_access_token

# WhatsApp — sent via the shared bnu WAHA (LAN → Tailscale socat chain via bg-proxmox :3001)
BG_WHATSAPP_GROUP_JID=____@g.us

# Modem/Router (Claro, HUMAX HGB10R-02) — admin portal login
BG_ROUTER_ADMIN_USER=admin
BG_ROUTER_ADMIN_PASSWORD=your_router_admin_password
BG_ROUTER_WIFI_PW=your_wifi_password

# =============================================================================
# BNU
# =============================================================================

# Raspberry Pi
BNU_RASPBERRYPI_HOST_KEY=your_host_key

# Home Assistant
BNU_HA_URL=http://bnu-homeassistant:8123
BNU_HA_TOKEN=your_long_lived_access_token

# WhatsApp — Casa Blumenau group JID (mirror into bnu-homeassistant secrets.yaml as whatsapp_group_jid)
BNU_WHATSAPP_GROUP_JID=____@g.us

# WhatsApp — WAHA (sole WhatsApp gateway; serves all regions). Runs in LXC 101 "docker"
# @ 10.1.1.126:3000, NOWEB engine, session persisted. Mirror into bnu-homeassistant
# secrets.yaml as: waha_api_url, waha_api_key, waha_session
BNU_WAHA_API_URL=http://10.1.1.126:3000
BNU_WAHA_API_KEY=generate_with__openssl_rand_hex_32
BNU_WAHA_SESSION=default
BNU_WAHA_DASHBOARD_USER=admin
BNU_WAHA_DASHBOARD_PASS=generate_with__openssl_rand_hex_12

# waha-listener — generic WhatsApp event platform (webhook archive + rule engine).
# Runs next to WAHA in LXC 101; see scripts/proxmox/docker/bnu-docker/waha-listener/
BNU_WAHA_LISTENER_URL=http://10.1.1.126:8788
BNU_WAHA_LISTENER_TOKEN=generate_with__openssl_rand_hex_32

# Frigate Digest — OpenAI (cloud LLM; also the automatic fallback when local Ollama fails).
# Mirror into bnu-homeassistant secrets.yaml as: openai_api_key
BNU_HA_FRIGATE_OPENAI_API_KEY=sk-...

# Frigate Debug — add to bnu-homeassistant secrets.yaml: whatsapp_smoketest_jid: <value>
# Uses the same group as SMOKETESTS_WHATSAPP_GROUP_JID (see bottom of this file)

# MQTT — Mosquitto add-on on bnu-homeassistant. First MQTT keys in the repo.
# NOTE: deliberately reuses the Frigate pair (mqtt-frigate), so condfy-bridge and
# Frigate currently share one credential. Recommended follow-up: create a
# dedicated non-admin HA user (mqtt-condfy) and split them.
BNU_MQTT_HOST=10.1.1.124
BNU_MQTT_PORT=1883
BNU_MQTT_USER=mqtt-frigate
BNU_MQTT_PASSWORD=your_mqtt_password
BNU_MQTT_DISCOVERY_PREFIX=homeassistant

# BNU Hikvision doorbell (DS-KB8112-IM) — ISAPI
BNU_DOORBELL_HOST=10.1.1.___
BNU_DOORBELL_USER=admin
BNU_DOORBELL_PW=your_doorbell_password

# =============================================================================
# PLY
# =============================================================================

# Raspberry Pi
PLY_RASPBERRYPI_HOST_KEY=your_host_key

# Home Assistant
PLY_HA_URL=http://ply-homeassistant:8123
PLY_HA_TOKEN=your_long_lived_access_token

# WhatsApp — sent via the shared bnu WAHA (Tailscale; PLY cutover pending)
PLY_WHATSAPP_GROUP_JID=____@g.us

# Synology NAS (ply-nas-ds918plus) — SSH access for LLM (user must be in the
# DSM administrators group; setup + key-auth upgrade: scripts/synology/README.md)
PLY_NAS_SSH_LOGIN=your_login
PLY_NAS_SSH_PW=your_password
# optional, preferred once key auth is set up (path is repo-relative, gitignored):
# PLY_NAS_SSH_KEY=gitignore/ply-nas_id_ed25519

# Synology NAS (ply-nas-ds918plus) — Copyparty file server (Tailscale-only),
# deployed at /volume1/docker/copyparty (source:
# scripts/synology/ply-synology/docker/copyparty/). The admin password below is
# mirrored in the gitignored copyparty.local.conf ON THE NAS; the three compose
# vars live in a local .env BESIDE the compose file on the NAS (not this file).
# See that folder's README.md.
PLY_COPYPARTY_PASSWORD=generate_with__openssl_rand_hex_12   # web/WebDAV login, user: ed
PLY_COPYPARTY_BIND_IP=127.0.0.1           # userspace tailscale => loopback (see compose)
PLY_COPYPARTY_PUID=1028                   # `id <dsm-user>` — owner of the share (globalnet)
PLY_COPYPARTY_PGID=100                    # DSM "users" group is 100

# =============================================================================
# FLN
# =============================================================================

# Raspberry Pi
FLN_RASPBERRYPI_HOST_KEY=your_host_key

# Home Assistant
FLN_HA_URL=http://fln-homeassistant:8123
FLN_HA_TOKEN=your_long_lived_access_token

# WhatsApp — sent via the shared bnu WAHA (Tailscale)
FLN_WHATSAPP_GROUP_JID=____@g.us

# =============================================================================
# ARA — House Hangar (Araquari, construction; no rack yet)
# =============================================================================

# globalnet /house/ara cockpit — fine-grained PAT, read-only Contents on
# eduardocenci/home-ara only, 1-year expiry (renew yearly!). Also goes in
# ~/globalnet/.env on each Pi running the dashboard container.
HOME_ARA_GITHUB_TOKEN=github_pat_...

# Construction credentials extracted by the ingest-home-docs skill land here
# as ARA_<DEVICE>_<FIELD>=... (cloud runs deliver them via a PR paste-block)

# =============================================================================
# SMOKETESTS
# =============================================================================

# WhatsApp group used for integration testing (shared bnu WAHA)
SMOKETESTS_WHATSAPP_GROUP_JID=____@g.us

# =============================================================================
# ARA (Casa Hangar — Araquari; see homes/ara)
# =============================================================================

# Casa Financeiro pipeline (skill finance-hangar in homes/ara; WhatsApp wake word
# "Casa, financeiro" via waha-listener + ebc.hangar@outlook.com mailbox → Google
# Sheet "PlanejadoRealizado_Financeiro" tab Financeiro + Drive CeuAzul/Financeiro/<ID>/).
# Sheet + Drive written with a Google service account (key file NEVER committed);
# share the sheet AND the Financeiro folder with the service-account e-mail.
ARA_FIN_SHEET_ID=your_google_sheet_id
ARA_FIN_DRIVE_FOLDER_ID=your_drive_folder_id
ARA_FIN_GROUP_JID=____@g.us
ARA_FIN_CONTRACTOR=55__________@c.us
ARA_FIN_GSA_KEYFILE=C:/path/to/repo/gitignore/finance/gsa-key.json
# claude CLI the headless run invokes (npm shim path on Windows)
ARA_FIN_TRIGGER_CLAUDE=C:/Users/<you>/AppData/Roaming/npm/claude.cmd
# PC endpoint that spawns a headless Claude run when the wake word fires
# (scripts/finance_trigger.py; registered as an at-logon Task Scheduler entry)
ARA_FIN_PC_TRIGGER_PORT=8799
ARA_FIN_PC_TRIGGER_URL=http://<pc-lan-ip>:8799/
# Mailbox senders whose statements feed the extrato pipeline (comma-separated)
ARA_EXTRATO_SENDERS=bank@example.com,another@example.com

# Google Drive for Desktop mount of CeuAzul/Financeiro. Service accounts have
# no storage quota, so uploads go through this mount (as the human user) and the
# API is only used to read the resulting link back.
ARA_FIN_DRIVE_LOCAL_ROOT=G:/My Drive/CeuAzul/Financeiro
ARA_FIN_DRIVE_MENSAL_LOCAL_ROOT=G:/My Drive/CeuAzul/Financeiro/Mensal
ARA_FIN_DRIVE_MENSAL_FOLDER_ID=your_drive_folder_id

# WhatsApp — Casa Hangar (ARA) group. The site's general channel, like the other
# <REGION>_WHATSAPP_GROUP_JID; condfy-bridge is just its first consumer.
ARA_WHATSAPP_GROUP_JID=____@g.us

# Canteiro camera — Intelbras iM9+ Full Color (Mibo) "iM9 M Full Color-9411",
# 192.168.1.56 on the house LAN (RTSP :554, Digest). User is always admin; the
# key is the camera's "chave de acesso" (base sticker / Mibo Cam app signup).
# Live copy: ara-raspberrypi:/etc/mediamtx/mediamtx.yml (see REMOTE_ACCESS.md §5).
ARA_CANTEIRO_CAM_USER=admin
ARA_CANTEIRO_CAM_KEY=your_camera_access_key

# Condfy — Céu Azul condominium portal. The condfy-bridge service
# (scripts/proxmox/docker/bnu-docker/condfy-bridge/, runs in LXC 101) polls the
# portal and publishes to MQTT (BNU HA) + WhatsApp for the watched people.
# On the LXC these are read unprefixed (CONDFY_*/MQTT_*) from
# /opt/condfy-bridge/.env — see that folder's README.md.
ARA_CONDFY_EMAIL=your_condfy_login_email
ARA_CONDFY_PASSWORD=your_condfy_password
ARA_CONDFY_BASE_URL=https://api.condfy.com.br/api/cwa
ARA_CONDFY_LICENSE_ID=9358
# Empty = probe the login routes and remember the one that works
ARA_CONDFY_LOGIN_PATH=
# Optional pre-seeded session JWT; empty = log in with e-mail/password
ARA_CONDFY_BOOTSTRAP_TOKEN=
ARA_CONDFY_WATCH_NAMES=Name One,Name Two
ARA_CONDFY_POLL_SECONDS=60
ARA_CONDFY_ALERT_COOLDOWN_MIN=10
ARA_CONDFY_ALERT_MAX_PER_HOUR=8
ARA_CONDFY_MAX_ALERT_AGE_MIN=60
# Weekly presence report (JPEG timeline → WhatsApp). Empty JID = report off.
ARA_CONDFY_REPORT_GROUP_JID=____@g.us
ARA_CONDFY_REPORT_PERSON=Name One
ARA_CONDFY_REPORT_PERSON_DISPLAY=Name One
ARA_CONDFY_REPORT_DOW=sun
ARA_CONDFY_REPORT_HOUR_LOCAL=8
